ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/itsm
DB_POOL_SIZE=20
CORS_ORIGINS=[]

# Network topology, used to build the DX OAuth2 redirect_uri and the login
# redirect target. Same spirit as CORS_ORIGINS — not owned by any one module.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Auth module: JWT session tokens and the stored DX token set (see app/modules/auth/config.py).
# AUTH__DX_TOKEN_FERNET_KEY encrypts the DX tokens kept for logout; DX_CORE__FERNET_KEY,
# its former name, is still read when it is unset.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH__JWT_SECRET=change-me-in-env
AUTH__ACCESS_TOKEN_TTL_SECONDS=1800
AUTH__REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH__COOKIE_SECURE=false
AUTH__DX_TOKEN_FERNET_KEY=

# Users module: the break-glass admin account (see app/seeds/seed_admin.py)
USERS__ADMIN_EMAIL=

# WeUp DX OAuth2 + PKCE (see app/integrations/dx_core/config.py). Never
# put a real client_id/secret here — placeholders only.
# DX_CORE__POST_LOGOUT_REDIRECT_URI is where DX sends the browser when a user also
# signs out of WeUp DX; leave it empty to use the URI registered for this client on
# DX, and if you set it, it must equal that registered value.
DX_CORE__API_BASE_URL=https://api-dx.weupbook.com
DX_CORE__CLIENT_ID=
DX_CORE__CLIENT_SECRET=
DX_CORE__SCOPES=
DX_CORE__POST_LOGOUT_REDIRECT_URI=

# DOCS_USERNAME / DOCS_PASSWORD only matter when ENV=stg — they gate /docs, /redoc, /openapi.json
DOCS_USERNAME=
DOCS_PASSWORD=

CACHE__URL=redis://redis:6379/0
CACHE__DEFAULT_TTL=300

QUEUE__URL=amqp://guest:guest@rabbitmq:5672/
QUEUE__PREFETCH=20

STORAGE__ENDPOINT=http://minio:9000
STORAGE__BUCKET=app
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin

# Audit log store (see app/integrations/mongo/config.py). The API connects at
# startup, so this must point at a reachable MongoDB.
MONGO__URL=mongodb://mongo:27017
MONGO__DATABASE_NAME=itsm

# Fernet keys encrypting secrets stored in the database — generate each one
# with the command in the auth block above, never reuse a real key here.
# Cloudflare: account API tokens (see app/modules/cloudflare/config.py)
CLOUDFLARE__FERNET_KEY=
# Observability: Loki credentials (see app/modules/observability/config.py)
OBSERVABILITY__FERNET_KEY=
# Notifications: channel secrets such as the Telegram bot token and the
# Base.vn webhook URL (see app/modules/notifications/config.py)
NOTIFICATIONS__FERNET_KEY=

# Observability module: the bearer token Alertmanager sends to
# POST /api/v1/webhooks/loki-alert, and how often app/scheduler.py re-checks
# DNS/Tunnel drift.
OBSERVABILITY__LOKI_WEBHOOK_SECRET=
OBSERVABILITY__RECONCILIATION_INTERVAL_SECONDS=1200

# Email notifications over SMTP (see app/integrations/email/config.py)
EMAIL__SMTP_HOST=
EMAIL__SMTP_PORT=587
EMAIL__SMTP_USERNAME=
EMAIL__SMTP_PASSWORD=
EMAIL__SMTP_FROM_ADDRESS=
EMAIL__SMTP_START_TLS=true
