ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/app
DB_POOL_SIZE=20
CORS_ORIGINS=[]

# Network topology, used to build the DX OAuth2 redirect_uri and the login
# redirect target. Same spirit as CORS_ORIGINS — not owned by any one module.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Auth module: JWT session tokens (see app/modules/auth/config.py)
AUTH__JWT_SECRET=change-me-in-env
AUTH__ACCESS_TOKEN_TTL_SECONDS=1800
AUTH__REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH__COOKIE_SECURE=false

# WeUpBook DX OAuth2 + PKCE (see app/integrations/dx_core/config.py). Never
# put a real client_id/secret/Fernet key here — placeholders only.
DX_CORE__API_BASE_URL=https://api-dx.weupbook.com
DX_CORE__CLIENT_ID=
DX_CORE__CLIENT_SECRET=
DX_CORE__SCOPES=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DX_CORE__FERNET_KEY=

# DOCS_USERNAME / DOCS_PASSWORD only matter when ENV=stg — they gate /docs, /redoc, /openapi.json
DOCS_USERNAME=
DOCS_PASSWORD=

CACHE__URL=redis://redis:6379/0
CACHE__DEFAULT_TTL=300

QUEUE__URL=amqp://guest:guest@rabbitmq:5672/
QUEUE__PREFETCH=20

STORAGE__ENDPOINT=http://minio:9000
STORAGE__BUCKET=app
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin
