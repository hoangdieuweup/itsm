[importlinter]
root_package = app

[importlinter:contract:auth-facade]
name = Other modules reach auth only through public.py
type = forbidden
source_modules =
    app.modules.rbac
    app.modules.users
    app.modules.common
forbidden_modules =
    app.modules.auth.repository
    app.modules.auth.models
    app.modules.auth.uow
    app.modules.auth.services
    app.modules.auth.utils
allow_indirect_imports = True

[importlinter:contract:rbac-facade]
name = Other modules reach rbac only through public.py
type = forbidden
source_modules =
    app.modules.auth
    app.modules.users
    app.modules.common
forbidden_modules =
    app.modules.rbac.repository
    app.modules.rbac.models
    app.modules.rbac.uow
    app.modules.rbac.services
allow_indirect_imports = True

[importlinter:contract:users-facade]
name = Other modules reach users only through public.py
type = forbidden
source_modules =
    app.modules.auth
    app.modules.rbac
    app.modules.common
forbidden_modules =
    app.modules.users.repository
    app.modules.users.models
    app.modules.users.uow
    app.modules.users.services
    app.modules.users.utils
allow_indirect_imports = True

[importlinter:contract:common-is-a-leaf-module]
name = common is a promotion target, not a hub — it never imports another domain module
type = forbidden
source_modules =
    app.modules.common
forbidden_modules =
    app.modules.auth
    app.modules.rbac
    app.modules.users
allow_indirect_imports = True

[importlinter:contract:root-is-mechanism]
name = The root holds mechanism and never imports a module
type = forbidden
source_modules =
    app.config
    app.constants
    app.core
forbidden_modules =
    app.modules
    app.integrations.cache
    app.integrations.queue
    app.integrations.storage
    app.integrations.dx_core

[importlinter:contract:integrations-are-leaves]
name = Integrations never import a domain module
type = forbidden
source_modules =
    app.integrations.cache
    app.integrations.queue
    app.integrations.storage
    app.integrations.dx_core
forbidden_modules =
    app.modules
