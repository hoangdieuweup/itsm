[importlinter:contract:root-is-mechanism]
name = The root holds mechanism and never imports a module
type = forbidden
source_modules =
    app.config
    app.constants
    app.core
forbidden_modules =
    app.modules
    app.integrations.cache
    app.integrations.queue
    app.integrations.storage
    app.integrations.dx_core
    app.integrations.mongo
    app.integrations.cloudflare
    app.integrations.loki
    app.integrations.email
    app.integrations.telegram
    app.integrations.base_vn

[importlinter:contract:integrations-are-leaves]
name = Integrations never import a domain module
type = forbidden
source_modules =
    app.integrations.cache
    app.integrations.queue
    app.integrations.storage
    app.integrations.dx_core
    app.integrations.mongo
    app.integrations.cloudflare
    app.integrations.loki
    app.integrations.email
    app.integrations.telegram
    app.integrations.base_vn
forbidden_modules =
    app.modules
